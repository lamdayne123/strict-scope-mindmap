    "mandatoryClosingPrompt": "Bạn có muốn tôi kiểm luôn các file còn lại không?"
  },
  "agentInstallPaths": {
    "claude-code": ".claude/skills/strict-scope-mindmap",
    "codex": ".codex/skills/strict-scope-mindmap",
    "cursor": ".cursor/skills/strict-scope-mindmap",
    "antigravity": ".agent/skills/strict-scope-mindmap",
    "universal": ".agents/skills/strict-scope-mindmap"
  }
}
